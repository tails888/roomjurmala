# Serve ES modules with a JavaScript MIME type on Apache hosts.
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
</IfModule>

RewriteEngine On

# Development sources and hidden files are never public website routes.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(?:server|content|scripts|tests|node_modules|docs)/ - [F,L]

# The calendar API is handled by PHP on Hostinger.
RewriteRule ^api(?:/.*)?$ api/index.php [END]

# Consolidated service pages now live under the existing space page.
RewriteRule ^(en/|ru/)?(?:bernu-ballites|telpas-nodarbibam)(?:/index\.html|/)?$ https://roomjurmala.lv/$1telpa/ [R=301,L,NE]


# Redirect explicit index.html URLs to the clean canonical directory URL.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ https://roomjurmala.lv/$1 [R=301,L,NE]

# Redirect the www host to the canonical non-www host.
RewriteCond %{HTTP_HOST} ^www\.roomjurmala\.lv$ [NC]
RewriteRule ^(.*)$ https://roomjurmala.lv/$1 [R=301,L,NE]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpe?g|webp|png|ico|svg|mp4|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(?:admin\.(?:js|css)|admin-auth\.mjs|event-model\.mjs|event-image\.mjs)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
